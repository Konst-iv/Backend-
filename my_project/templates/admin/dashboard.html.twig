{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Админ-панель Booking System{% endblock %}

{% block page_content %}
<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Пользователи</h5>
                        <p class="card-text h2">{{ user_count }}</p>
                    </div>
                    <i class="fa fa-users fa-3x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Дома</h5>
                        <p class="card-text h2">{{ house_count }}</p>
                    </div>
                    <i class="fa fa-home fa-3x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Бронирования</h5>
                        <p class="card-text h2">{{ booking_count }}</p>
                    </div>
                    <i class="fa fa-calendar fa-3x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Активные</h5>
                        <p class="card-text h2">{{ active_bookings }}</p>
                    </div>
                    <i class="fa fa-check-circle fa-3x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Быстрые действия</h5>
            </div>
            <div class="card-body">
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\HouseCrudController') }}" 
                   class="btn btn-primary me-2">
                    <i class="fa fa-plus"></i> Добавить дом
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\BookingCrudController') }}" 
                   class="btn btn-success me-2">
                    <i class="fa fa-eye"></i> Просмотр бронирований
                </a>
                <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}" 
                   class="btn btn-info">
                    <i class="fa fa-user-plus"></i> Управление пользователями
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}